{
  "name": "nekkoreader",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  },
  "description": "NekkoReader — leitor de mangá, HQ, livros e PDFs (renderização lazy + cache LRU)",
  "author": "Edlon Engenharia",
  "main": "electron/main.cjs",
  "build": {
    "appId": "br.com.edlon.nekkoreader",
    "productName": "NekkoReader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-unrar-js/**"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "NekkoReader-Portable-${version}.exe"
    }
  },
  "version": "3.0.0"
}
